# Copy this file to .env and fill in your keys
# cp demo/.env.example demo/.env

# OpenAI
# OPENAI_API_KEY=sk-your-key-here

# DeepSeek (or any OpenAI-compatible API)
LLM_API_KEY=sk-your-key-here
LLM_API_BASE=https://api.deepseek.com/v1
# Model name — query your account's available models via:
#   curl https://api.deepseek.com/models -H "Authorization: Bearer $LLM_API_KEY"
# Common options: deepseek-v4-flash (fast), deepseek-v4-pro (powerful)
LLM_MODEL=deepseek-v4-flash
# Some providers (e.g. Kimi k3-256k) only accept temperature=1.
# LLM_TEMPERATURE=1

# HTTP timeout for LLM requests in seconds. Increase this if you see
# "Request timed out" on slow providers or multi-stock comparisons.
# LLM_TIMEOUT=120

# Or use a local LLM via Ollama/LM Studio
# LLM_API_KEY=ollama
# LLM_API_BASE=http://localhost:11434/v1

# ── Risk appetite (default normal) ──
# conservative / normal / aggressive
# Affects chat advice style, technical-signal thresholds, and paper-trading behavior.
# RISK_MODE=normal

# ── Market monitor (S1) ──
# Check interval (seconds, default 300 = 5 minutes)
# MONITOR_INTERVAL=300
# Daily price-move alert threshold (%, default 5)
# MONITOR_MOVE_THRESHOLD=5
# Daily briefing time (default 08:50)
# MONITOR_BRIEFING_TIME=08:50
# Alert webhook (optional, e.g. DingTalk/Lark/ServerChan JSON webhook)
# WEBHOOK_URL=https://your-webhook-endpoint
