# Copy this file to .env and fill in your keys
# cp demo/.env.example demo/.env

# OpenAI
# OPENAI_API_KEY=sk-your-key-here

# DeepSeek (or any OpenAI-compatible API)
LLM_API_KEY=sk-your-key-here
LLM_API_BASE=https://api.deepseek.com/v1
# Model name — query your account's available models via:
#   curl https://api.deepseek.com/models -H "Authorization: Bearer $LLM_API_KEY"
# Common options: deepseek-v4-flash (fast), deepseek-v4-pro (powerful)
LLM_MODEL=deepseek-v4-flash

# Or use a local LLM via Ollama/LM Studio
# LLM_API_KEY=ollama
# LLM_API_BASE=http://localhost:11434/v1

# ── 盯盘监控（S1）──
# 检查间隔（秒，默认 300 = 5 分钟）
# MONITOR_INTERVAL=300
# 单日异动告警阈值（%，默认 5）
# MONITOR_MOVE_THRESHOLD=5
# 每日早报时间（默认 08:50）
# MONITOR_BRIEFING_TIME=08:50
# 告警 webhook（可选，钉钉/飞书/Server酱等通用 JSON webhook）
# WEBHOOK_URL=https://your-webhook-endpoint
